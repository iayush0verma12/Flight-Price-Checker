# Copy this file to .env and fill in your values.
# You can ALSO edit all of this from the dashboard Settings panel at runtime
# (values entered in the dashboard are stored in data/store.json and take
# precedence over this file after the first save).

PORT=3000

# Kiwi.com Tequila API (https://partners.kiwi.com/tequila) — free instant signup.
# Primary price source: real-ish fares, nonstop/layover info, and a ready
# deep_link that redirects straight to Kiwi's booking checkout for that flight.
KIWI_API_KEY=

# Amadeus for Developers (https://developers.amadeus.com) — free self-service tier.
# Used as a fallback if Kiwi isn't configured or a lookup fails.
# Sign up, create an app, copy the API Key / API Secret below.
# ENV=test uses the sandbox (fake-ish data, fine for building/testing).
# ENV=production requires requesting production access from Amadeus for real live fares.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENV=test

# SMTP settings used to send report / alert emails.
# Example for Gmail: host=smtp.gmail.com port=587 secure=false
# Gmail requires an "App Password" (not your normal password) if 2FA is on.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Flight Price Checker <no-reply@example.com>"
